ANTHROPIC_API_KEY=sk-ant-...

# Alternative via OpenRouter (proxy with access to Claude, GPT, Gemini, etc.)
# Needed if your card isn't accepted directly by Anthropic.
OPENROUTER_API_KEY=sk-or-v1-...

# "anthropic" (default) or "openrouter". See src/provider/index.ts.
LLM_PROVIDER=openrouter

# Empty = each provider picks its own default (see createProvider).
LLM_MODEL=anthropic/claude-sonnet-4.6
