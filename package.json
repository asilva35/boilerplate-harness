{
  "name": "boilerplate-harness",
  "version": "0.1.0",
  "description": "Educational, progressive harness engineering boilerplate in TypeScript",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "tui": "tsx src/tui.tsx",
    "web": "tsx src/server.ts",
    "web:build": "npm run build --prefix web-app",
    "scaffold": "tsx scripts/scaffold.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "openai": "^4.68.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.5.13",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
